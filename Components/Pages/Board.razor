@page "/board"
@layout GameLayout
@inject GameStateService GameState
@inject QrCodeService QrService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="board-container">
    <!-- Top Scoreboard Bar -->
    <div class="scoreboard-header">
        <!-- Team 1 Box -->
        <div class="team-box" style="color: @GameState.Team1.Color;">
            <div class="team-name">@GameState.Team1.Name</div>
            <div class="team-score">@GameState.Team1.Score</div>
        </div>

        <!-- Team 1 Buzzer QR Code (Between Team 1 Points and Round Bank) -->
        <div class="team-qr-container">
            <a href="@_team1BuzzerUrl" target="_blank" class="team-qr-link" title="Join @GameState.Team1.Name (@_team1BuzzerUrl)">
                <div class="team-qr-card" style="--team-glow: @GameState.Team1.Color; border-color: @GameState.Team1.Color;">
                    <div class="team-qr-badge" style="background-color: @GameState.Team1.Color;">
                        📱 BUZZ IN
                    </div>
                    <div class="team-qr-graphic">
                        @if (!string.IsNullOrEmpty(_team1QrSvg))
                        {
                            @((MarkupString)_team1QrSvg)
                        }
                    </div>
                    <div class="team-qr-teamname" style="color: @GameState.Team1.Color;">
                        @GameState.Team1.Name
                    </div>
                </div>
            </a>
        </div>

        <!-- Round Bank Box -->
        <div class="bank-box">
            <div class="bank-label">ROUND BANK</div>
            <div class="bank-score">@GameState.RoundBank</div>
            <div class="round-badge">
                ROUND @(GameState.CurrentRoundIndex + 1) • @(GameState.CurrentQuestion.Multiplier)X POINTS
            </div>
        </div>

        <!-- Team 2 Buzzer QR Code (Between Round Bank and Team 2 Points) -->
        <div class="team-qr-container">
            <a href="@_team2BuzzerUrl" target="_blank" class="team-qr-link" title="Join @GameState.Team2.Name (@_team2BuzzerUrl)">
                <div class="team-qr-card" style="--team-glow: @GameState.Team2.Color; border-color: @GameState.Team2.Color;">
                    <div class="team-qr-badge" style="background-color: @GameState.Team2.Color;">
                        📱 BUZZ IN
                    </div>
                    <div class="team-qr-graphic">
                        @if (!string.IsNullOrEmpty(_team2QrSvg))
                        {
                            @((MarkupString)_team2QrSvg)
                        }
                    </div>
                    <div class="team-qr-teamname" style="color: @GameState.Team2.Color;">
                        @GameState.Team2.Name
                    </div>
                </div>
            </a>
        </div>

        <!-- Team 2 Box -->
        <div class="team-box" style="color: @GameState.Team2.Color;">
            <div class="team-name">@GameState.Team2.Name</div>
            <div class="team-score">@GameState.Team2.Score</div>
        </div>
    </div>

    <!-- Question Display -->
    <div class="question-bar">
        @GameState.CurrentQuestion.Text
    </div>

    <!-- Live Buzzer Winner Alert -->
    @if (GameState.Buzzer.WinnerTeam != null)
    {
        var winnerColor = GameState.GetTeamColor(GameState.Buzzer.WinnerTeam);
        <div class="buzzer-alert-banner" style="--banner-color: @winnerColor;">
            🔔 @GameState.Buzzer.WinnerTeam.ToUpper()
            @if (!string.IsNullOrWhiteSpace(GameState.Buzzer.WinnerPlayer))
            {
                <span>(@GameState.Buzzer.WinnerPlayer)</span>
            }
            BUZZED IN FIRST!
        </div>
    }

    <!-- 8-Slot Answer Board (2 columns x 4 rows) -->
    <div class="feud-board my-4">
        @for (int slot = 0; slot < 8; slot++)
        {
            var answer = slot < GameState.CurrentQuestion.Answers.Count
                ? GameState.CurrentQuestion.Answers[slot]
                : null;

            <div class="flip-card @(answer != null && answer.IsRevealed ? "flipped" : "")">
                <div class="flip-card-inner">
                    <!-- FRONT (Covered) -->
                    <div class="flip-card-front">
                        @if (answer != null)
                        {
                            <div class="number-oval">@(slot + 1)</div>
                        }
                    </div>

                    <!-- BACK (Revealed) -->
                    <div class="flip-card-back">
                        @if (answer != null)
                        {
                            <div class="answer-text">@answer.Text</div>
                            <div class="answer-points">@answer.Points</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Strikes Display -->
    <div class="strike-row">
        @for (int s = 1; s <= 3; s++)
        {
            <div class="strike-slot @(GameState.Strikes >= s ? "active" : "")">
                X
            </div>
        }
    </div>

    <!-- Footer join hint -->
    <div class="text-center mt-4 text-light opacity-50 small">
        To buzz in, scan your team's QR code above or join at: <strong class="text-warning">@(QrService.BuildBuzzerUrl(Nav.Uri))</strong>
    </div>
</div>

<!-- Giant Transient Strike Animation Overlay -->
@if (_showStrikeOverlay)
{
    <div class="giant-strike-overlay" @onclick="() => _showStrikeOverlay = false">
        <div class="giant-strike-x">
            @for (int i = 0; i < Math.Max(1, GameState.Strikes); i++)
            {
                <span>X</span>
            }
        </div>
    </div>
}

@code {
    private long _lastBuzzerHandled;
    private long _lastDingHandled;
    private long _lastStrikeHandled;
    private bool _showStrikeOverlay = false;

    private string _team1BuzzerUrl = string.Empty;
    private string _team2BuzzerUrl = string.Empty;
    private string _team1QrSvg = string.Empty;
    private string _team2QrSvg = string.Empty;

    protected override void OnInitialized()
    {
        GameState.OnChange += HandleStateChanged;
        _lastBuzzerHandled = GameState.LastBuzzerEventId;
        _lastDingHandled = GameState.LastDingEventId;
        _lastStrikeHandled = GameState.LastStrikeEventId;

        InitTeamQrCodes();
    }

    private void InitTeamQrCodes()
    {
        try
        {
            _team1BuzzerUrl = QrService.BuildBuzzerUrl(Nav.Uri, "1");
            _team2BuzzerUrl = QrService.BuildBuzzerUrl(Nav.Uri, "2");
            _team1QrSvg = QrService.GenerateSvgQrCode(_team1BuzzerUrl);
            _team2QrSvg = QrService.GenerateSvgQrCode(_team2BuzzerUrl);
        }
        catch
        {
            // fallback if QR generation has any issue
        }
    }

    private async void HandleStateChanged()
    {
        // Check for Buzzer sound
        if (GameState.LastBuzzerEventId != _lastBuzzerHandled)
        {
            _lastBuzzerHandled = GameState.LastBuzzerEventId;
            await JS.InvokeVoidAsync("feudAudio.playBuzzer");
        }

        // Check for Ding sound (Answer revealed)
        if (GameState.LastDingEventId != _lastDingHandled)
        {
            _lastDingHandled = GameState.LastDingEventId;
            await JS.InvokeVoidAsync("feudAudio.playDing");
        }

        // Check for Strike sound & visual overlay
        if (GameState.LastStrikeEventId != _lastStrikeHandled)
        {
            _lastStrikeHandled = GameState.LastStrikeEventId;
            _showStrikeOverlay = true;
            await JS.InvokeVoidAsync("feudAudio.playStrike");

            _ = Task.Run(async () =>
            {
                await Task.Delay(1300);
                _showStrikeOverlay = false;
                await InvokeAsync(StateHasChanged);
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameState.OnChange -= HandleStateChanged;
    }
}
