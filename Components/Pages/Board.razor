@page "/board"
@layout GameLayout
@inject GameStateService GameState
@inject QrCodeService QrService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (!GameState.FastMoney.IsActive)
{
    <div class="board-container">
        <!-- Top Scoreboard Bar -->
        <div class="scoreboard-header">
            <!-- Team 1 Box -->
            <div class="team-box" style="color: @GameState.Team1.Color;">
                <div class="team-name">@GameState.Team1.Name</div>
                <div class="team-score">@GameState.Team1.Score</div>
            </div>

            <!-- Team 1 Buzzer QR Code (Between Team 1 Points and Round Bank) -->
            <div class="team-qr-container">
                <a href="@_team1BuzzerUrl" target="_blank" class="team-qr-link" title="Join @GameState.Team1.Name (@_team1BuzzerUrl)">
                    <div class="team-qr-card" style="--team-glow: @GameState.Team1.Color; border-color: @GameState.Team1.Color;">
                        <div class="team-qr-badge" style="background-color: @GameState.Team1.Color;">
                            📱 BUZZ IN
                        </div>
                        <div class="team-qr-graphic">
                            @if (!string.IsNullOrEmpty(_team1QrSvg))
                            {
                                @((MarkupString)_team1QrSvg)
                            }
                        </div>
                        <div class="team-qr-teamname" style="color: @GameState.Team1.Color;">
                            @GameState.Team1.Name
                        </div>
                    </div>
                </a>
            </div>

            <!-- Round Bank Box -->
            <div class="bank-box">
                <div class="bank-label">ROUND BANK</div>
                <div class="bank-score">@GameState.RoundBank</div>
                <div class="round-badge">
                    ROUND @(GameState.CurrentRoundIndex + 1) • @(GameState.CurrentQuestion.Multiplier)X POINTS
                </div>
            </div>

            <!-- Team 2 Buzzer QR Code (Between Round Bank and Team 2 Points) -->
            <div class="team-qr-container">
                <a href="@_team2BuzzerUrl" target="_blank" class="team-qr-link" title="Join @GameState.Team2.Name (@_team2BuzzerUrl)">
                    <div class="team-qr-card" style="--team-glow: @GameState.Team2.Color; border-color: @GameState.Team2.Color;">
                        <div class="team-qr-badge" style="background-color: @GameState.Team2.Color;">
                            📱 BUZZ IN
                        </div>
                        <div class="team-qr-graphic">
                            @if (!string.IsNullOrEmpty(_team2QrSvg))
                            {
                                @((MarkupString)_team2QrSvg)
                            }
                        </div>
                        <div class="team-qr-teamname" style="color: @GameState.Team2.Color;">
                            @GameState.Team2.Name
                        </div>
                    </div>
                </a>
            </div>

            <!-- Team 2 Box -->
            <div class="team-box" style="color: @GameState.Team2.Color;">
                <div class="team-name">@GameState.Team2.Name</div>
                <div class="team-score">@GameState.Team2.Score</div>
            </div>
        </div>

        <!-- Question Display -->
        <div class="question-bar">
            @GameState.CurrentQuestion.Text
        </div>

        <!-- Live Buzzer Winner Alert -->
        @if (GameState.Buzzer.WinnerTeam != null)
        {
            var winnerColor = GameState.GetTeamColor(GameState.Buzzer.WinnerTeam);
            <div class="buzzer-alert-banner" style="--banner-color: @winnerColor;">
                🔔 @GameState.Buzzer.WinnerTeam.ToUpper()
                @if (!string.IsNullOrWhiteSpace(GameState.Buzzer.WinnerPlayer))
                {
                    <span>(@GameState.Buzzer.WinnerPlayer)</span>
                }
                BUZZED IN FIRST!
            </div>
        }

        <!-- 8-Slot Answer Board (Official column-major layout: Left Column #1-#4, Right Column #5-#8) -->
        <div class="feud-board my-4">
            @for (int slot = 0; slot < 8; slot++)
            {
                var answer = slot < GameState.CurrentQuestion.Answers.Count
                    ? GameState.CurrentQuestion.Answers[slot]
                    : null;

                <div class="flip-card @(answer != null && answer.IsRevealed ? "flipped" : "")">
                    <div class="flip-card-inner">
                        <!-- FRONT (Covered) -->
                        <div class="flip-card-front">
                            @if (answer != null)
                            {
                                <div class="number-oval">@(slot + 1)</div>
                            }
                        </div>

                        <!-- BACK (Revealed) -->
                        <div class="flip-card-back">
                            @if (answer != null)
                            {
                                <div class="answer-text">@answer.Text</div>
                                <div class="answer-points">@answer.Points</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Strikes Display -->
        <div class="strike-row">
            @for (int s = 1; s <= 3; s++)
            {
                <div class="strike-slot @(GameState.Strikes >= s ? "active" : "")">
                    X
                </div>
            }
        </div>

        <!-- Footer join hint -->
        <div class="text-center mt-4 text-light opacity-50 small">
            To buzz in, scan your team's QR code above or join at: <strong class="text-warning">@(QrService.BuildBuzzerUrl(Nav.Uri))</strong>
        </div>
    </div>
}
else
{
    <!-- FAST MONEY AUDIENCE BOARD -->
    <div class="fastmoney-board-container">
        <!-- Top Fast Money Header -->
        <div class="fastmoney-header">
            <!-- Winning Team Info -->
            <div class="fm-team-card" style="--team-glow: @(GameState.FastMoney.WinningTeamNumber == 1 ? GameState.Team1.Color : GameState.Team2.Color);">
                <div class="fm-team-title">PLAYING FOR THE GRAND PRIZE</div>
                <div class="fm-team-name" style="color: @(GameState.FastMoney.WinningTeamNumber == 1 ? GameState.Team1.Color : GameState.Team2.Color);">
                    @(GameState.FastMoney.WinningTeamNumber == 1 ? GameState.Team1.Name : GameState.Team2.Name)
                </div>
            </div>

            <!-- Central Fast Money Title & Player Indicator -->
            <div class="fm-title-box">
                <div class="fm-title-badge">⚡ FAST MONEY ⚡</div>
                <div class="fm-player-indicator">
                    @(GameState.FastMoney.CurrentPlayer == 1 ? "PLAYER 1 • 20 SECONDS" : "PLAYER 2 • 25 SECONDS")
                </div>
            </div>

            <!-- Timer Display -->
            <div class="fm-timer-card @(GameState.FastMoney.IsTimerRunning ? "running" : "") @(GameState.FastMoney.TimeRemaining <= 5 && GameState.FastMoney.TimeRemaining > 0 ? "critical" : "")">
                <div class="fm-timer-label">CLOCK</div>
                <div class="fm-timer-digit">@GameState.FastMoney.TimeRemaining</div>
            </div>

            <!-- Grand Total Score Box (Target: 200) -->
            <div class="fm-total-card @(GameState.FastMoney.HasWonGrandPrize ? "winner-pulse" : "")">
                <div class="fm-total-label">TOTAL SCORE</div>
                <div class="fm-total-score">@GameState.FastMoney.CombinedRevealedTotal</div>
                <div class="fm-total-target">TARGET: 200</div>
            </div>
        </div>

        <!-- Duplicate Warning Alert Banner -->
        @if (!string.IsNullOrWhiteSpace(GameState.FastMoney.DuplicateWarningMessage))
        {
            <div class="fm-duplicate-banner animate-duplicate">
                🚨 @GameState.FastMoney.DuplicateWarningMessage
            </div>
        }

        <!-- 5 Questions / Answers Dual Columns Board -->
        <div class="fm-grid-board my-4">
            <!-- Columns Header: Player 1 / Questions / Player 2 -->
            <div class="fm-column-header-row">
                <div class="fm-column-header">PLAYER 1</div>
                <div class="fm-column-header-center">SURVEY QUESTIONS</div>
                <div class="fm-column-header">PLAYER 2</div>
            </div>

            @for (int i = 0; i < Math.Min(5, GameState.FastMoney.Questions.Count); i++)
            {
                var qIndex = i;
                var question = GameState.FastMoney.Questions[qIndex];
                var p1 = qIndex < GameState.FastMoney.Player1Answers.Count ? GameState.FastMoney.Player1Answers[qIndex] : null;
                var p2 = qIndex < GameState.FastMoney.Player2Answers.Count ? GameState.FastMoney.Player2Answers[qIndex] : null;

                <div class="fm-row-item">
                    <!-- Player 1 Answer & Points -->
                    <div class="fm-slot p1-slot @(p1 != null && p1.IsAnswerRevealed ? "revealed" : "")">
                        <div class="fm-slot-answer">
                            @(p1 != null && p1.IsAnswerRevealed && !string.IsNullOrWhiteSpace(p1.AnswerText) ? p1.AnswerText : "")
                        </div>
                        <div class="fm-slot-points @(p1 != null && p1.IsPointsRevealed ? "points-active" : "")">
                            @(p1 != null && p1.IsPointsRevealed ? p1.Points.ToString() : "")
                        </div>
                    </div>

                    <!-- Question Number & Prompt Indicator -->
                    <div class="fm-slot-center @(question.IsRevealed ? "revealed" : "hidden")" title="@(question.IsRevealed ? question.Question : $"Question #{i + 1}")">
                        <span class="fm-q-badge">#@(i + 1)</span>
                        @if (question.IsRevealed)
                        {
                            <span class="fm-q-text">@question.Question</span>
                        }
                        else
                        {
                            <span class="fm-q-hidden">••••••••</span>
                        }
                    </div>

                    <!-- Player 2 Answer & Points -->
                    <div class="fm-slot p2-slot @(p2 != null && p2.IsAnswerRevealed ? "revealed" : "") @(p2 != null && p2.IsDuplicate ? "duplicate-highlight" : "")">
                        <div class="fm-slot-answer">
                            @(p2 != null && p2.IsAnswerRevealed && !string.IsNullOrWhiteSpace(p2.AnswerText) ? p2.AnswerText : "")
                        </div>
                        <div class="fm-slot-points @(p2 != null && p2.IsPointsRevealed ? "points-active" : "")">
                            @(p2 != null && p2.IsPointsRevealed ? p2.Points.ToString() : "")
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Grand Prize Win Banner if 200 reached -->
        @if (GameState.FastMoney.HasWonGrandPrize)
        {
            <div class="fm-win-celebration">
                <div class="fm-win-sparkle">🎉 GRAND PRIZE WINNERS! 🎉</div>
                <div class="fm-win-subtitle">200+ POINTS SCORED! CONGRATULATIONS!</div>
            </div>
        }
    </div>
}

<!-- Giant Transient Strike Animation Overlay -->
@if (_showStrikeOverlay)
{
    <div class="giant-strike-overlay" @onclick="() => _showStrikeOverlay = false">
        <div class="giant-strike-x">
            @for (int i = 0; i < Math.Max(1, GameState.Strikes); i++)
            {
                <span>X</span>
            }
        </div>
    </div>
}

@code {
    private long _lastBuzzerHandled;
    private long _lastDingHandled;
    private long _lastStrikeHandled;
    private long _lastDuplicateHandled;
    private long _lastWinHandled;
    private bool _showStrikeOverlay = false;

    private string _team1BuzzerUrl = string.Empty;
    private string _team2BuzzerUrl = string.Empty;
    private string _team1QrSvg = string.Empty;
    private string _team2QrSvg = string.Empty;

    protected override void OnInitialized()
    {
        GameState.OnChange += HandleStateChanged;
        _lastBuzzerHandled = GameState.LastBuzzerEventId;
        _lastDingHandled = GameState.LastDingEventId;
        _lastStrikeHandled = GameState.LastStrikeEventId;
        _lastDuplicateHandled = GameState.LastDuplicateEventId;
        _lastWinHandled = GameState.LastWinEventId;

        InitTeamQrCodes();
    }

    private void InitTeamQrCodes()
    {
        try
        {
            _team1BuzzerUrl = QrService.BuildBuzzerUrl(Nav.Uri, "1");
            _team2BuzzerUrl = QrService.BuildBuzzerUrl(Nav.Uri, "2");
            _team1QrSvg = QrService.GenerateSvgQrCode(_team1BuzzerUrl);
            _team2QrSvg = QrService.GenerateSvgQrCode(_team2BuzzerUrl);
        }
        catch
        {
            // fallback if QR generation has any issue
        }
    }

    private async void HandleStateChanged()
    {
        // Check for Buzzer sound
        if (GameState.LastBuzzerEventId != _lastBuzzerHandled)
        {
            _lastBuzzerHandled = GameState.LastBuzzerEventId;
            await JS.InvokeVoidAsync("feudAudio.playBuzzer");
        }

        // Check for Ding sound (Answer revealed)
        if (GameState.LastDingEventId != _lastDingHandled)
        {
            _lastDingHandled = GameState.LastDingEventId;
            await JS.InvokeVoidAsync("feudAudio.playDing");
        }

        // Check for Duplicate buzz sound
        if (GameState.LastDuplicateEventId != _lastDuplicateHandled)
        {
            _lastDuplicateHandled = GameState.LastDuplicateEventId;
            await JS.InvokeVoidAsync("feudAudio.playDuplicate");
        }

        // Check for Win Fanfare sound
        if (GameState.LastWinEventId != _lastWinHandled)
        {
            _lastWinHandled = GameState.LastWinEventId;
            await JS.InvokeVoidAsync("feudAudio.playWin");
        }

        // Check for Strike sound & visual overlay
        if (GameState.LastStrikeEventId != _lastStrikeHandled)
        {
            _lastStrikeHandled = GameState.LastStrikeEventId;
            _showStrikeOverlay = true;
            await JS.InvokeVoidAsync("feudAudio.playStrike");

            _ = Task.Run(async () =>
            {
                await Task.Delay(1300);
                _showStrikeOverlay = false;
                await InvokeAsync(StateHasChanged);
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameState.OnChange -= HandleStateChanged;
    }
}
