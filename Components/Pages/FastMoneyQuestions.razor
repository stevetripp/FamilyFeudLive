@page "/fastmoney-questions"
@layout GameLayout
@inject GameStateService GameState
@inject NavigationManager Nav
@implements IDisposable

<div class="fm-phone-container">
    <!-- Header Title & Status -->
    <div class="d-flex justify-content-between align-items-center py-2 mb-2 border-bottom border-secondary">
        <div>
            <h5 class="fw-bold text-warning mb-0">🎙️ Fast Money Host Desk</h5>
            <small class="text-secondary">Host Reading Card & 3s/5s Timer Controller</small>
        </div>
        <div class="d-flex gap-1">
            <button class="btn btn-sm @(GameState.FastMoney.CurrentPlayer == 1 ? "btn-info text-dark fw-bold" : "btn-outline-secondary")"
                    @onclick="() => GameState.SetFastMoneyPlayer(1)">
                P1 (3s)
            </button>
            <button class="btn btn-sm @(GameState.FastMoney.CurrentPlayer == 2 ? "btn-info text-dark fw-bold" : "btn-outline-secondary")"
                    @onclick="() => GameState.SetFastMoneyPlayer(2)">
                P2 (5s)
            </button>
        </div>
    </div>

    @if (GameState.FastMoney.Questions.Count == 0)
    {
        <div class="card bg-dark text-white border-warning p-4 text-center">
            <div class="display-4 mb-2">📋</div>
            <h5 class="text-warning fw-bold">No Fast Money Questions Loaded</h5>
            <p class="text-secondary small mb-3">
                Load questions in the Host Desk on your computer, and they will immediately appear here.
            </p>
            <a href="/host" class="btn btn-outline-info btn-sm">Go to Host Desk</a>
        </div>
    }
    else
    {
        int activeQIndex = GameState.FastMoney.ActiveQuestionIndex;
        var q = activeQIndex >= 0 && activeQIndex < GameState.FastMoney.Questions.Count
            ? GameState.FastMoney.Questions[activeQIndex]
            : GameState.FastMoney.Questions[0];

        var pAnswers = GameState.FastMoney.CurrentPlayer == 1 ? GameState.FastMoney.Player1Answers : GameState.FastMoney.Player2Answers;
        var currentSlot = activeQIndex >= 0 && activeQIndex < pAnswers.Count ? pAnswers[activeQIndex] : null;

        <!-- Question Navigation Tabs (1-5) -->
        <div class="d-flex justify-content-between gap-1 mb-3">
            @for (int i = 0; i < Math.Min(5, GameState.FastMoney.Questions.Count); i++)
            {
                var qIdx = i;
                var slot = qIdx < pAnswers.Count ? pAnswers[qIdx] : null;
                bool isDone = slot != null && !string.IsNullOrWhiteSpace(slot.AnswerText);
                bool isActive = activeQIndex == qIdx;

                <button class="btn btn-sm flex-fill fw-bold @(isActive ? "btn-warning text-dark shadow" : isDone ? "btn-success" : "btn-outline-secondary text-white")"
                        @onclick="() => GameState.SetFastMoneyActiveQuestion(qIdx)">
                    Q@(qIdx + 1) @(isDone ? "✓" : "")
                </button>
            }
        </div>

        <!-- MAIN ACTIVE QUESTION CARD -->
        <div class="card bg-dark text-white border-warning shadow mb-3 fm-phone-qcard">
            <div class="card-header bg-dark bg-opacity-75 border-bottom border-secondary d-flex justify-content-between align-items-center py-2 px-3">
                <span class="badge bg-warning text-dark fw-bold fs-6">Question @(activeQIndex + 1) of 5</span>
                <span class="badge bg-info text-dark fw-bold">
                    Playing: Player @GameState.FastMoney.CurrentPlayer (@(GameState.FastMoney.CurrentPlayer == 1 ? "3s" : "5s"))
                </span>
            </div>

            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
                    <span class="badge @(q.IsRevealed ? "bg-success" : "bg-secondary")">
                        @(q.IsRevealed ? "🟢 TV BOARD: VISIBLE" : "🙈 TV BOARD: HIDDEN")
                    </span>
                    <button class="btn btn-sm @(q.IsRevealed ? "btn-outline-secondary" : "btn-warning text-dark fw-bold")"
                            @onclick="() => GameState.ToggleFastMoneyQuestionReveal(activeQIndex)">
                        @(q.IsRevealed ? "🙈 Hide Question" : "👁️ Enable Question on TV")
                    </button>
                </div>

                <!-- Large Question Text for Host Reading -->
                <div class="fm-phone-qtext mb-3">
                    @q.Question
                </div>

                <!-- Host Reference Answers (Shows points & top rank) -->
                <div class="p-2 rounded bg-black bg-opacity-50 border border-secondary mb-3">
                    <div class="text-secondary small fw-bold mb-1">SURVEY ANSWERS & POINTS REFERENCE:</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var ans in q.Answers)
                        {
                            <span class="badge bg-secondary text-white p-2">
                                @ans.Answer: <strong class="text-warning">@ans.Points pts</strong>
                            </span>
                        }
                    </div>
                </div>

                <!-- LIVE INTERACTION CONTROLLER -->
                @if (GameState.FastMoney.QuestionPhase == "Waiting")
                {
                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg fw-bold py-3 fs-5 shadow"
                                @onclick="() => GameState.StartFastMoneyQuestionTimer()">
                            ▶ START @(GameState.FastMoney.CurrentPlayer == 1 ? "3-SECOND" : "5-SECOND") TIMER & REVEAL OPTIONS
                        </button>
                    </div>
                }
                else if (GameState.FastMoney.QuestionPhase == "Answering")
                {
                    <div class="p-3 rounded bg-warning bg-opacity-25 border border-warning text-center mb-2">
                        <div class="display-4 fw-bold text-warning mb-1">
                            ⏱️ @GameState.FastMoney.QuestionTimeRemaining.ToString("0.0")s
                        </div>
                        <div class="text-warning fw-bold small text-uppercase animate__animated animate__pulse animate__infinite">
                            Contestant phone is active! Waiting for tap...
                        </div>
                    </div>
                    <div class="d-grid">
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => GameState.StopFastMoneyQuestionTimer()">
                            ⏹ Cancel / Stop Timer
                        </button>
                    </div>
                }
                else if (GameState.FastMoney.QuestionPhase == "Answered")
                {
                    <div class="alert alert-success border-success text-center py-2 mb-3">
                        <div class="text-secondary small fw-bold">CONTESTANT SELECTED:</div>
                        <div class="display-6 fw-bold text-white mb-1">
                            @currentSlot?.AnswerText
                        </div>
                        <div class="text-warning fw-bold">
                            @currentSlot?.Points Points
                        </div>
                        <div class="text-muted small">
                            (Revealed on TV Board: Answer text only. Points will be revealed during recap!)
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        @if (activeQIndex + 1 < Math.Min(5, GameState.FastMoney.Questions.Count))
                        {
                            <button class="btn btn-primary btn-lg fw-bold py-2 shadow"
                                    @onclick="() => GameState.NextFastMoneyActiveQuestion()">
                                Next Question (Q@(activeQIndex + 2)) ▶
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-info text-center py-2 fw-bold mb-2">
                                🎉 All 5 Questions Answered for Player @GameState.FastMoney.CurrentPlayer!
                            </div>
                            @if (GameState.FastMoney.CurrentPlayer == 1)
                            {
                                <button class="btn btn-info btn-lg fw-bold py-2 shadow text-dark"
                                        @onclick="() => GameState.SetFastMoneyPlayer(2)">
                                    Switch to Player 2 (5s per question) ▶
                                </button>
                            }
                        }

                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="() => GameState.ResetFastMoneyCurrentQuestion()">
                            🔄 Re-read / Restart Question @(activeQIndex + 1)
                        </button>
                    </div>
                }
                else if (GameState.FastMoney.QuestionPhase == "Expired")
                {
                    <div class="alert alert-danger border-danger text-center py-2 mb-3">
                        <div class="fs-5 fw-bold text-white mb-1">
                            ⏰ Time Expired!
                        </div>
                        <div class="text-danger fw-bold small">
                            0 Points recorded for this question.
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        @if (activeQIndex + 1 < Math.Min(5, GameState.FastMoney.Questions.Count))
                        {
                            <button class="btn btn-primary btn-lg fw-bold py-2 shadow"
                                    @onclick="() => GameState.NextFastMoneyActiveQuestion()">
                                Next Question (Q@(activeQIndex + 2)) ▶
                            </button>
                        }
                        else if (GameState.FastMoney.CurrentPlayer == 1)
                        {
                            <button class="btn btn-info btn-lg fw-bold py-2 shadow text-dark"
                                    @onclick="() => GameState.SetFastMoneyPlayer(2)">
                                Switch to Player 2 (5s per question) ▶
                            </button>
                        }

                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="() => GameState.ResetFastMoneyCurrentQuestion()">
                            🔄 Re-read / Restart Question @(activeQIndex + 1)
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- POST-ROUND POINTS RECAP ACCORDION / TOOLBAR -->
        <div class="card bg-dark border-secondary p-3 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-warning fw-bold small">🏆 POST-ROUND POINTS RECAP</span>
                <span class="badge bg-warning text-dark fw-bold">
                    Total: @GameState.FastMoney.CombinedRevealedTotal / 200 pts
                </span>
            </div>
            <div class="text-secondary small mb-3">
                Reveal points one-by-one on the TV Board after all questions are completed:
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-sm align-middle mb-2">
                    <thead>
                        <tr class="text-secondary small">
                            <th>#</th>
                            <th>P1 Answer</th>
                            <th class="text-center">P1 Pts</th>
                            <th>P2 Answer</th>
                            <th class="text-center">P2 Pts</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Math.Min(5, GameState.FastMoney.Questions.Count); i++)
                        {
                            var qIdx = i;
                            var p1 = qIdx < GameState.FastMoney.Player1Answers.Count ? GameState.FastMoney.Player1Answers[qIdx] : null;
                            var p2 = qIdx < GameState.FastMoney.Player2Answers.Count ? GameState.FastMoney.Player2Answers[qIdx] : null;

                            <tr>
                                <td class="fw-bold text-warning">Q@(qIdx + 1)</td>
                                <td class="small">@(p1?.AnswerText ?? "-")</td>
                                <td class="text-center">
                                    <button class="btn btn-xs @(p1 != null && p1.IsPointsRevealed ? "btn-success" : "btn-outline-warning")"
                                            style="font-size: 0.75rem; padding: 2px 6px;"
                                            @onclick="() => GameState.ToggleFastMoneyPointsReveal(1, qIdx)">
                                        @(p1 != null && p1.IsPointsRevealed ? $"{p1.Points} pts" : "👁️ Reveal")
                                    </button>
                                </td>
                                <td class="small">@(p2?.AnswerText ?? "-")</td>
                                <td class="text-center">
                                    <button class="btn btn-xs @(p2 != null && p2.IsPointsRevealed ? "btn-success" : "btn-outline-warning")"
                                            style="font-size: 0.75rem; padding: 2px 6px;"
                                            @onclick="() => GameState.ToggleFastMoneyPointsReveal(2, qIdx)">
                                        @(p2 != null && p2.IsPointsRevealed ? $"{p2.Points} pts" : "👁️ Reveal")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="btn-group btn-group-sm w-100">
                <button class="btn btn-outline-warning" @onclick="() => GameState.RevealAllFastMoneyPoints(1)">
                    Reveal All P1 Points
                </button>
                <button class="btn btn-outline-warning" @onclick="() => GameState.RevealAllFastMoneyPoints(2)">
                    Reveal All P2 Points
                </button>
            </div>
        </div>
    }

    <!-- Quick Footer Navigation -->
    <div class="text-center text-secondary small py-3">
        <span>Family Feud Live • Fast Money Host Assistant</span>
    </div>
</div>

<style>
    .fm-phone-container {
        max-width: 650px;
        margin: 0 auto;
        padding: 12px;
        min-height: 100vh;
    }

    .fm-phone-qcard {
        border-width: 2px;
        border-radius: 12px;
        overflow: hidden;
    }

    .fm-phone-qtext {
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.4;
        color: #ffffff;
        letter-spacing: 0.3px;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    }
</style>

@code {
    protected override void OnInitialized()
    {
        GameState.OnChange += HandleStateChanged;
    }

    private async void HandleStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameState.OnChange -= HandleStateChanged;
    }
}
