@page "/"
@layout GameLayout
@inject GameStateService GameState
@inject QrCodeService QrService
@inject NavigationManager Nav

<div class="container py-5 text-center">
    <div class="mb-5">
        <h1 class="display-3 fw-bold text-warning" style="text-shadow: 0 0 25px rgba(245, 183, 0, 0.6);">
            FAMILY FEUD LIVE
        </h1>
        <p class="lead text-light opacity-75">
            Interactive TV Game Show Board & Real-Time Mobile Buzzer System
        </p>
    </div>

    <div class="row g-4 justify-content-center mb-5">
        <!-- Big Screen TV Board -->
        <div class="col-md-4">
            <div class="card h-100 bg-dark text-white border-warning shadow-lg p-4 text-center">
                <div class="display-1 mb-3">📺</div>
                <h3 class="fw-bold text-warning">TV Display Board</h3>
                <p class="text-light opacity-75">
                    Open this on the big TV or projector screen. Displays the flip-card board, scores, strikes, and buzzer alerts.
                </p>
                <div class="mt-auto">
                    <a href="/board" target="_blank" class="btn btn-warning btn-lg fw-bold w-100">
                        Launch TV Board
                    </a>
                </div>
            </div>
        </div>

        <!-- Host Controller -->
        <div class="col-md-4">
            <div class="card h-100 bg-dark text-white border-info shadow-lg p-4 text-center">
                <div class="display-1 mb-3">🎙️</div>
                <h3 class="fw-bold text-info">Host Control Desk</h3>
                <p class="text-light opacity-75">
                    For the game host on a laptop or tablet. Reveal answers, activate buzzers, issue strikes, and award points.
                </p>
                <div class="mt-auto">
                    <a href="/host" target="_blank" class="btn btn-info btn-lg fw-bold w-100 text-dark">
                        Launch Host Desk
                    </a>
                </div>
            </div>
        </div>

        <!-- Phone Buzzer -->
        <div class="col-md-4">
            <div class="card h-100 bg-dark text-white border-danger shadow-lg p-4 text-center">
                <div class="display-1 mb-3">📱</div>
                <h3 class="fw-bold text-danger">Player Buzzer</h3>
                <p class="text-light opacity-75">
                    For contestants on their smartphones. Select a team and smash the buzzer for the face-off question!
                </p>
                <div class="mt-auto">
                    <a href="/buzzer" target="_blank" class="btn btn-danger btn-lg fw-bold w-100">
                        Open Buzzer
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Wi-Fi Connection Guide & QR Code -->
    <div class="card bg-dark border-warning shadow-lg p-4 max-w-900 mx-auto text-start">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h4 class="text-warning fw-bold mb-3 d-flex align-items-center gap-2">
                    <span>📲</span> Connecting Phones on Wi-Fi
                </h4>
                <ol class="text-light opacity-90 ps-3 mb-3">
                    <li class="mb-2">Make sure your computer and players' phones are on the <strong>same Wi-Fi network</strong>.</li>
                    <li class="mb-2">Point phone cameras at the <strong>QR Code</strong> on the right to open the buzzer instantly.</li>
                    <li class="mb-2">
                        Or enter this address manually in any mobile browser:
                        <div class="mt-1">
                            <span class="badge bg-warning text-dark fs-6 font-monospace p-2 user-select-all">
                                @_buzzerUrl
                            </span>
                        </div>
                    </li>
                </ol>

                @if (_availableIps.Count > 1)
                {
                    <div class="mt-3 pt-2 border-top border-secondary">
                        <label class="form-label text-secondary small fw-bold mb-1">Select Network IP (if using Wi-Fi / Ethernet):</label>
                        <select class="form-select form-select-sm bg-dark text-white border-secondary w-auto"
                                @bind="_selectedIp" @bind:after="UpdateQrCode">
                            @foreach (var ip in _availableIps)
                            {
                                <option value="@ip">@ip</option>
                            }
                        </select>
                    </div>
                }
            </div>

            <!-- QR Code Card -->
            <div class="col-lg-5 text-center">
                <div class="p-3 bg-light rounded-4 shadow d-inline-block" style="max-width: 250px;">
                    @if (!string.IsNullOrEmpty(_qrCodeSvg))
                    {
                        <div style="width: 190px; height: 190px; margin: 0 auto; display: flex; align-items: center; justify-content: center;">
                            @((MarkupString)_qrCodeSvg)
                        </div>
                    }
                    <div class="text-dark fw-bold mt-2 small text-uppercase letter-spacing-1">
                        Scan for Buzzer 📱
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<string> _availableIps = new();
    private string _selectedIp = "localhost";
    private int _port = 5046;
    private string _buzzerUrl = string.Empty;
    private string _qrCodeSvg = string.Empty;

    protected override void OnInitialized()
    {
        try
        {
            var uri = new Uri(Nav.Uri);

            // Port 7267 is HTTPS, which triggers SSL handshake errors if visited via http://
            // Default phones to the HTTP port (5046) so local Wi-Fi connections never have SSL warnings
            _port = (uri.Port == 7267) ? 5046 : (uri.Port > 0 ? uri.Port : 5046);

            _availableIps = QrService.GetLocalIPv4Addresses();
            
            // If current url isn't localhost/loopback, use that host
            if (!uri.IsLoopback && !string.IsNullOrEmpty(uri.Host))
            {
                _selectedIp = uri.Host;
            }
            else
            {
                // Prefer the first non-localhost IPv4
                _selectedIp = _availableIps.FirstOrDefault(ip => ip != "localhost" && ip != "127.0.0.1") ?? "localhost";
            }
        }
        catch
        {
            _selectedIp = "localhost";
            _port = 5046;
        }

        UpdateQrCode();
    }

    private void UpdateQrCode()
    {
        _buzzerUrl = $"http://{_selectedIp}:{_port}/buzzer";
        _qrCodeSvg = QrService.GenerateSvgQrCode(_buzzerUrl);
    }
}
